# Credenciales: NUNCA al repositorio.
config.php
acceso.json

# private/* y no private/: así se puede designorar private/.htaccess (abajo).
# Con "private/" a secas Git ignora la carpeta entera y la excepción no
# tendría efecto. La lección viene de finanzas: sesion.php y antiabuso.php
# CREAN private/ solas en cuanto alguien entra, así que su .htaccess tiene
# que viajar con el código o la carpeta nacería abierta.
private/*
!private/.htaccess

# Facturas y papeles personales que se dejan en disco para que Claude los grabe
# en la app (van por la API, no por el repositorio ni por FTP).
facturas/

# Informes en HTML para mandar a mano (WhatsApp, correo): llevan datos personales.
informes/

# Copias y temporales
*.log
*.bak
*.tmp
*.sqlite
.DS_Store
Thumbs.db
